{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix auto-infographic install",
  "buildCommand": "npm --prefix auto-infographic run build",
  "outputDirectory": "auto-infographic/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
