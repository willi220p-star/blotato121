# Copy to .env and fill in an LLM key to use remember/recall.
# The API and UI start without a key; ingestion and graph queries need one.

LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini

ENV=local
LOG_LEVEL=INFO
HTTP_API_HOST=0.0.0.0
HTTP_API_PORT=8000
CORS_ALLOWED_ORIGINS=*

# Local single-user mode: no login required.
ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=false

# Frontend (used by scripts/start-ui.sh)
COGNEE_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_IS_CLOUD_ENVIRONMENT=false
