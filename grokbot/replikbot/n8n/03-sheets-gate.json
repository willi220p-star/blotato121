{
  "name": "ReplikBot — 3 Sheets Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "replikbot-check",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "sheets-check-webhook",
      "name": "Manual check webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "replikbot-check",
      "notes": "Only when ReplikBot asks to check one pending Video id. No 2-minute poll. No 10-minute timer. Body: videoId."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1lnmnTMi6pLVSIaFH73YWg8qdTZPCA95S5LspaNVQzPI"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Video id",
              "lookupValue": "={{ $json.body.videoId || $json.videoId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "sheets-read-row",
      "name": "Read Sheet1 row by Video id",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-video-id",
              "leftValue": "={{ $json['Video id'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "missing-link",
              "leftValue": "={{ $json['Video link'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "sheets-if-pending",
      "name": "Has Video id, missing Video link",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Manual check webhook": {
      "main": [
        [
          {
            "node": "Read Sheet1 row by Video id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Sheet1 row by Video id": {
      "main": [
        [
          {
            "node": "Has Video id, missing Video link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Gate 3: on-demand check for one Video id when the user asks ReplikBot. Ready Gate webhook is the primary writer. Voice is never a sheet field."
  }
}
