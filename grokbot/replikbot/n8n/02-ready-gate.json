{
  "name": "ReplikBot — 2 Ready Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "replikbot-ready",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "ready-webhook",
      "name": "RepliQ ready webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "replikbot-ready-gate"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success-yes",
              "leftValue": "={{ $json.body.videoSuccess || $json.videoSuccess }}",
              "rightValue": "YES",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ready-if-success",
      "name": "videoSuccess is YES",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1lnmnTMi6pLVSIaFH73YWg8qdTZPCA95S5LspaNVQzPI"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Video id": "={{ $json.body.id || $json.id }}",
            "Video link": "={{ $json.body.videoLink || $json.videoLink }}",
            "Video Html": "={{ $json.body.htmlCode || $json.htmlCode }}",
            "Icebreaker id": "={{ $json.body.icebreakerId || $json.icebreakerId || '' }}",
            "Icebreaker": "={{ $json.body.icebreaker || $json.icebreaker || '' }}",
            "updates": "Ready"
          },
          "matchingColumns": ["Video id"]
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "ready-write-success",
      "name": "Write video link and icebreaker",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [500, -80],
      "notes": "Fill Video link + Icebreaker on the same Sheet1 row. Do not write voice."
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1lnmnTMi6pLVSIaFH73YWg8qdTZPCA95S5LspaNVQzPI"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Video id": "={{ $json.body.id || $json.id }}",
            "updates": "Failed: videoSuccess was not YES"
          },
          "matchingColumns": ["Video id"]
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "ready-write-fail",
      "name": "Write failure note",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [500, 120]
    }
  ],
  "connections": {
    "RepliQ ready webhook": {
      "main": [
        [
          {
            "node": "videoSuccess is YES",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "videoSuccess is YES": {
      "main": [
        [
          {
            "node": "Write video link and icebreaker",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Write failure note",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Gate 2: RepliQ webhook. On YES, write Video link and Icebreaker into Sheet1. Never write voice."
  }
}
