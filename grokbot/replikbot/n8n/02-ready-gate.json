{
  "name": "ReplikBot — 2 Ready Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "replikbot-ready",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "ready-webhook",
      "name": "RepliQ ready webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "replikbot-ready-gate"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success-yes",
              "leftValue": "={{ $json.body.videoSuccess || $json.videoSuccess }}",
              "rightValue": "YES",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ready-if-success",
      "name": "videoSuccess is YES",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appyGe81SFdPW8Ivz"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblnC3xzdTN2dPQQS"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.body.airtableRecordId || $json.airtableRecordId }}",
            "Status": "Ready",
            "videoSuccess": "YES",
            "Video id": "={{ $json.body.id || $json.id }}",
            "Video link": "={{ $json.body.videoLink || $json.videoLink }}",
            "Video Html": "={{ $json.body.htmlCode || $json.htmlCode }}",
            "Icebreaker id": "={{ $json.body.icebreakerId || $json.icebreakerId || '' }}"
          }
        }
      },
      "id": "ready-mark-ready",
      "name": "Mark job Ready",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [500, -80]
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appyGe81SFdPW8Ivz"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblnC3xzdTN2dPQQS"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.body.airtableRecordId || $json.airtableRecordId }}",
            "Status": "Failed",
            "videoSuccess": "NO",
            "Tags": ["Failed"],
            "Error": "={{ $json.body.status || $json.status || 'RepliQ videoSuccess was not YES' }}"
          }
        }
      },
      "id": "ready-mark-failed",
      "name": "Mark job Failed",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [500, 120]
    }
  ],
  "connections": {
    "RepliQ ready webhook": {
      "main": [
        [
          {
            "node": "videoSuccess is YES",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "videoSuccess is YES": {
      "main": [
        [
          {
            "node": "Mark job Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark job Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Gate 2: RepliQ webhook. Only YES continues. Put this webhook URL into Launch as webhook."
  }
}
