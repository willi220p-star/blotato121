{
  "name": "ReplikBot — 1 Launch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "replikbot-launch",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "launch-chat-webhook",
      "name": "Chat launch webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "replikbot-launch",
      "notes": "Triggered by ReplikBot after chat intake. Body: website, websiteName, firstName, lastName, templateId, templateName, qualifyGrade, email, linkedinUrl, jobTitle. No sheet poll. No 10-minute timer."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-website",
              "leftValue": "={{ $json.body.website || $json.website }}",
              "rightValue": "http",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            },
            {
              "id": "grade-in-range",
              "leftValue": "={{ Number($json.body.qualifyGrade || $json.qualifyGrade || 0) }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "launch-if-quality",
      "name": "Website set, qualify grade >= 7",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.repliq.co/v2/launchTemplate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"templateId\": \"{{ $json.body.templateId || $json.templateId }}\",\n  \"url\": \"{{ $json.body.website || $json.website }}\",\n  \"firstName\": \"{{ $json.body.firstName || $json.firstName }}\",\n  \"lastName\": \"{{ $json.body.lastName || $json.lastName }}\",\n  \"companyName\": \"{{ $json.body.websiteName || $json.websiteName }}\",\n  \"jobTitle\": \"{{ $json.body.jobTitle || $json.jobTitle || '' }}\",\n  \"email\": \"{{ $json.body.email || $json.email || '' }}\",\n  \"webhook\": \"{{ $env.REPLIKBOT_READY_WEBHOOK_URL }}\"\n}",
        "options": {}
      },
      "id": "launch-repliq",
      "name": "RepliQ launchTemplate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, -100],
      "notes": "Header auth: Authorization Bearer REPLIQ_API_KEY. templateId comes from chat (matched by template name). url is the website background. Template already has small intro + large overlay videos. Do not send icebreaker. Do not write voice."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1lnmnTMi6pLVSIaFH73YWg8qdTZPCA95S5LspaNVQzPI"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Linkedin Url": "={{ $('Chat launch webhook').item.json.body.linkedinUrl || $('Chat launch webhook').item.json.linkedinUrl || '' }}",
            "Linkedin Title": "={{ $('Chat launch webhook').item.json.body.jobTitle || $('Chat launch webhook').item.json.jobTitle || '' }}",
            "Emails": "={{ $('Chat launch webhook').item.json.body.email || $('Chat launch webhook').item.json.email || '' }}",
            "Website": "={{ $('Chat launch webhook').item.json.body.website || $('Chat launch webhook').item.json.website }}",
            "first name": "={{ $('Chat launch webhook').item.json.body.firstName || $('Chat launch webhook').item.json.firstName }}",
            "last name": "={{ $('Chat launch webhook').item.json.body.lastName || $('Chat launch webhook').item.json.lastName }}",
            "company name": "={{ $('Chat launch webhook').item.json.body.websiteName || $('Chat launch webhook').item.json.websiteName }}",
            "qualify grade": "={{ $('Chat launch webhook').item.json.body.qualifyGrade || $('Chat launch webhook').item.json.qualifyGrade }}",
            "qualification potential": "={{ $('Chat launch webhook').item.json.body.qualifyReason || $('Chat launch webhook').item.json.qualifyReason || '' }}",
            "Video id": "={{ $json.id }}",
            "updates": "={{ 'Pending | template: ' + ($('Chat launch webhook').item.json.body.templateName || $('Chat launch webhook').item.json.templateName || '') }}"
          },
          "matchingColumns": []
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "launch-write-id",
      "name": "Append Sheet1 after launch",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [760, -100]
