            "Linkedin Title": "={{ $json.body.jobTitle || $json.jobTitle || '' }}",
            "Emails": "={{ $json.body.email || $json.email || '' }}",
            "Website": "={{ $json.body.website || $json.website }}",
            "first name": "={{ $json.body.firstName || $json.firstName }}",
            "last name": "={{ $json.body.lastName || $json.lastName }}",
